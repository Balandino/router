digraph gogv {
   rankdir=LR
   bgcolor="black"
   node [shape=box, style=rounded, color="white", fontcolor="white", fontname=Helvetica, fontsize=12]
   edge [fontname=Helvetica, fontsize=10, fontcolor="white", color="white"]
   graph [fontcolor="white", color="white"]
   subgraph cluster_c0000 {
      labelloc="t" labeljust="l" color="purple" label=<
               <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="0">
                  <TR>
                     <TD><IMG SRC="icons/Architecture-Group-Icons/Virtual-private-cloud-VPC_32.svg"/></TD>
                     <TD><B>c0000</B></TD>
                  </TR>
               </TABLE>
            >
      subgraph cluster_sub1 {
         labelloc="t" labeljust="l" color=" #40E0D0" label=<
                  <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="0">
                     <TR>
                        <TD><IMG SRC="icons/Architecture-Group-Icons/Private-subnet_32.svg"/></TD>
                        <TD><B>sub-1</B></TD>
                     </TR>
                  </TABLE>
               >
         i123 [shape=none, fontcolor="white", label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
                   <TR>
                      <TD><IMG SRC="icons/Architecture-Service-Icons/Arch_Compute/32/Arch_Amazon-EC2_32.svg"/></TD>
                   </TR>
                   <TR>
                      <TD>i-123</TD>
                   </TR>
                </TABLE>
                 >]
         i789 [shape=none, fontcolor="white", label=<
                <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
                   <TR>
                      <TD><IMG SRC="icons/Architecture-Service-Icons/Arch_Compute/32/Arch_Amazon-EC2_32.svg"/></TD>
                   </TR>
                   <TR>
                      <TD>i-789</TD>
                   </TR>
                </TABLE>
                 >]
      }
      subgraph cluster_sub2 {
         labelloc="t" labeljust="l" color=" #40E0D0" label=<
                  <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="0">
                     <TR>
                        <TD><IMG SRC="icons/Architecture-Group-Icons/Private-subnet_32.svg"/></TD>
                        <TD><B>sub-2</B></TD>
                     </TR>
                  </TABLE>
               >
         _empty_placeholder [label="", shape=point, width=0, height=0, fixedsize=true, style=invis];
      }
   }
i123 -> i789 [label="My Link"]
sub1 -> sub2 [label="subnet link"]
}